DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
JWT_ACCESS_SECRET="change-me-access-secret-with-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-with-at-least-32-chars"
CLIENT_URL="https://your-storesync-project.vercel.app"
VITE_API_URL="/api"
VITE_IDLE_TIMEOUT_MINUTES="30"
# Jangan isi NODE_ENV di Vercel: NODE_ENV=production membuat `npm ci` melewati devDependencies
# (Vite, TypeScript, Prisma CLI) sehingga build gagal. Vercel sudah memakai mode production saat runtime.
SESSION_IDLE_MINUTES="45"

# Cloudflare R2
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="storesync"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_FORCE_PATH_STYLE="false"
