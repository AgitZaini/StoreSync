generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEADER
  SPG
  KASIR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FilePurpose {
  ATTENDANCE_PHOTO
  CASHIER_PHOTO
  DOCTOR_NOTE
  RETURN_PHOTO
  STOCK_OPNAME_EVIDENCE
  VISIT_EVIDENCE
  MOU_SIGNATURE
  MOU_SIGNER_PHOTO
  MOU_DOCUMENT
}

enum FileStatus {
  PENDING
  UPLOADED
}

enum PharmacyStatus {
  /// Calon mitra dari MOU (Tahap 8); belum punya akun kasir.
  PROSPECT
  ACTIVE
  INACTIVE
}

model User {
  id                 String     @id @default(uuid())
  name               String
  /// Nomor HP dalam format 62xxxxxxxxxx, dipakai untuk login.
  phone              String     @unique
  passwordHash       String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  /// Tim tempat SPG bernaung (BR-04: satu SPG hanya di satu tim).
  teamId             String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens RefreshToken[]
  notifications Notification[]
  files         FileObject[]
  team          Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeam       Team?          @relation("TeamLeader")
  kasirPharmacy Pharmacy?      @relation("PharmacyKasir")
  placements    Placement[]
  salesTargets  SalesTarget[]

  @@index([role, status])
  @@index([teamId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  /// Waktu token ini terakhir dipakai; dasar pemutusan sesi yang tidak aktif.
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// Riwayat perubahan (LOG-01). Append-only: trigger di migrasi menolak UPDATE dan DELETE.
model AuditLog {
  id              String    @id @default(uuid())
  actorId         String?
  actorRole       UserRole?
  action          String
  entity          String
  entityId        String?
  before          Json?
  after           Json?
  evidenceFileIds String[]  @default([])
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model FileObject {
  id           String      @id @default(uuid())
  key          String      @unique
  purpose      FilePurpose
  mimeType     String
  size         Int
  status       FileStatus  @default(PENDING)
  uploadedById String
  createdAt    DateTime    @default(now())
  uploadedAt   DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById, createdAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  leaderId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leader  User   @relation("TeamLeader", fields: [leaderId], references: [id])
  members User[] @relation("TeamMembers")
}

model Pharmacy {
  id          String         @id @default(uuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  /// Radius absen dalam meter (AB-02, bawaan 20 m).
  radiusM     Int            @default(20)
  is24h       Boolean        @default(false)
  /// Jam buka/tutup "HH:mm" WIB; kosong bila buka 24 jam.
  openTime    String?
  closeTime   String?
  status      PharmacyStatus @default(ACTIVE)
  /// Akun Kasir Apotek bersama (AKN-03); kosong hanya untuk calon mitra.
  kasirUserId String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  kasir      User?       @relation("PharmacyKasir", fields: [kasirUserId], references: [id])
  placements Placement[]

  @@index([status])
}

/// Penempatan SPG di apotek (maks. 3 aktif per SPG). Tidak dihapus; diakhiri dengan `endedAt`.
model Placement {
  id         String    @id @default(uuid())
  spgId      String
  pharmacyId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  endReason  String?
  createdAt  DateTime  @default(now())

  spg      User     @relation(fields: [spgId], references: [id])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([spgId, endedAt])
  @@index([pharmacyId, endedAt])
}

model Product {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  unit      String
  price     Decimal  @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Target omzet per SPG per bulan (AKN-04).
model SalesTarget {
  id        String   @id @default(uuid())
  spgId     String
  /// Format YYYY-MM.
  month     String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spg User @relation(fields: [spgId], references: [id])

  @@unique([spgId, month])
  @@index([month])
}

/// Nominal potongan cuti per hari (AKN-05). Riwayat disimpan karena tarif baru hanya berlaku
/// untuk cuti yang disetujui setelah `effectiveFrom`.
model DeductionRate {
  id            String   @id @default(uuid())
  amountPerDay  Decimal  @db.Decimal(14, 2)
  effectiveFrom DateTime @default(now())
  createdById   String
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
}
