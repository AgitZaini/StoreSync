DATABASE_URL="postgresql://storesync:storesync_dev@localhost:5432/storesync?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-with-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-with-at-least-32-chars"
PORT=4000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Sesi ditutup bila refresh token tidak dipakai selama ini (menit).
SESSION_IDLE_MINUTES=45
LOGIN_RATE_LIMIT_PER_15_MIN=20

# Penyimpanan berkas: MinIO dari docker-compose (lokal) atau Cloudflare R2 (produksi).
S3_ENDPOINT="http://localhost:9100"
S3_REGION="auto"
S3_BUCKET="storesync"
S3_ACCESS_KEY_ID="storesync"
S3_SECRET_ACCESS_KEY="storesync_dev"
S3_FORCE_PATH_STYLE="true"

# Opsional: Super Admin pertama untuk environment baru (dibuat oleh `npm run db:seed`).
# SEED_SUPER_ADMIN_NAME="Super Admin"
# SEED_SUPER_ADMIN_PHONE="0812xxxxxxxx"
# SEED_SUPER_ADMIN_PASSWORD="ganti-dengan-sandi-sementara1"
